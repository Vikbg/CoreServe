# Example .env file for CoreServe

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_very_secret_password
DB_NAME=coreserve
DB_NAME_TEST=coreserve_test
DB_PORT=3306
DB_CONNECTION_LIMIT=10
JWT_SECRET=supersecret
JWT_EXPIRES_IN=1d
PORT=3000
HOST=0.0.0.0
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000
JSON_LIMIT=10kb
TEST_API_KEY=replace_with_a_test_only_api_key
